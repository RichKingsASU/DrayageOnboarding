{
  "name": "drayage-onboarding-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "tsc --noEmit && webpack --mode production",
    "preview": "webpack serve --mode production",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:demo": "cross-env AUTH_MODE=auto_demo playwright test",
    "test:e2e:prod": "cross-env AUTH_MODE=required playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "esbuild": "^0.25.0",
    "style-loader": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}

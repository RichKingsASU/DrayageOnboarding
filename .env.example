# Frontend-safe variables used by the browser-side Vite application.
VITE_SUPABASE_URL="http://localhost:54321"
VITE_SUPABASE_ANON_KEY="replace-with-local-or-project-anon-key"

# Privileged local/CI smoke-test script only. Never expose these to browser code and never use a VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row-Level Security and must be stored only in trusted secret stores.
SUPABASE_URL="http://localhost:54321"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key-from-secure-secret-store"

# Azure provisioning inputs. Store DB_ADMIN_PASSWORD in a CI/CD secret, password manager, or Key Vault-backed workflow.
DB_ADMIN_PASSWORD="replace-with-secure-secret"
POSTGRES_ALLOWED_START_IP="203.0.113.10"
POSTGRES_ALLOWED_END_IP="203.0.113.10"

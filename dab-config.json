{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v0.12.0/dab.draft.schema.json",
  "data-source": {
    "database-type": "postgresql",
    "connection-string": "@env('AzureWebJobsStorage')"
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api"
    },
    "graphql": {
      "enabled": false
    },
    "host": {
      "cors": {
        "origins": [
          "http://localhost:5173"
        ],
        "allow-credentials": true
      },
      "authentication": {
        "provider": "StaticWebApps"
      }
    }
  },
  "entities": {
    "Account": {
      "source": "accounts",
      "rest": true,
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["create", "read", "update", "delete"]
        }
      ]
    },
    "Contact": {
      "source": "contacts",
      "rest": true,
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["create", "read", "update", "delete"]
        }
      ]
    },
    "AccessorialSop": {
      "source": "accessorial_sops",
      "rest": true,
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["create", "read", "update", "delete"]
        }
      ]
    },
    "Document": {
      "source": "documents",
      "rest": true,
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["create", "read", "update", "delete"]
        }
      ]
    }
  }
}
